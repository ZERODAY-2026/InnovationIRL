# Copy this file to .env and fill it in. Never commit .env or any key file.
# Each teammate keeps their own .env; nothing here is shared.

# --- Snowflake (key-pair auth, read-only app role; see snowflake/setup.sql) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DATAMIND_APP
SNOWFLAKE_ROLE=DATAMIND_READER
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=DATAMIND
# Absolute path to the private key created by scripts/gen_keypair.py (keep it outside the repo).
SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Dataset profile (profiles/<name>.yaml) ---
DATAMIND_PROFILE=tpch

# --- Gemma runtime ---
# Primary tier: Gemma through the Gemini API (free key from Google AI Studio).
# No-key setup: set GEMMA_PROVIDER=ollama, GEMMA_FALLBACK=none and OLLAMA_HOST below.
GEMMA_PROVIDER=gemini
# Backup tier, used only on a 429, a timeout or a connection error. "none" disables it.
GEMMA_FALLBACK=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Optional per-role override, e.g. the stronger model for SQL planning only.
# GEMINI_MODEL_PLAN=gemma-4-31b-it

# Ollama on this machine (http://localhost:11434) or a LAN machine (http://<ip>:11434).
# Leave empty if you have no Ollama; the backup tier is then skipped.
OLLAMA_HOST=
# Verify the tag with `ollama list`; prefer the QAT build on 6 GB or smaller GPUs.
OLLAMA_MODEL=gemma4:e4b
# Per-machine context length (2048-4096). Prompts that do not fit are shrunk or rejected, never silently cut.
OLLAMA_NUM_CTX=4096

# Concurrent model calls (1-2 keeps laptops cool).
GEMMA_MAX_CONCURRENCY=1
