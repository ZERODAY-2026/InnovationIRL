# Copy this file to .env and fill it in. Never commit .env or any key file.

# --- Snowflake (key-pair auth, read-only app role) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=DATAMIND_READER
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=DATAMIND
SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Gemma runtime (default: local Ollama, no API key needed) ---
GEMMA_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Verify the tag with `ollama list`; prefer the QAT build on 6 GB GPUs.
OLLAMA_MODEL=gemma4:e4b
# Per-machine setting. Keep it modest so the model stays fully on the GPU.
OLLAMA_NUM_CTX=4096

# --- Optional cloud Gemma (Gemini API) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
